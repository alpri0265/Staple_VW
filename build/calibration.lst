  10:Core/Src/calibration.c **** // ===== Flash EEPROM =====
  11:Core/Src/calibration.c **** // Використовуємо останній сектор (Sector 7, 128KB, 0x08060000)
  12:Core/Src/calibration.c **** 
  13:Core/Src/calibration.c **** #define FLASH_EEPROM_SECTOR  FLASH_SECTOR_7
  14:Core/Src/calibration.c **** #define FLASH_EEPROM_ADDR    0x08060000UL
  15:Core/Src/calibration.c **** 
  16:Core/Src/calibration.c **** #pragma pack(1)
  17:Core/Src/calibration.c **** typedef struct {
  18:Core/Src/calibration.c ****     float   scale;
  19:Core/Src/calibration.c ****     int32_t offset;
  20:Core/Src/calibration.c ****     float   target_force;
  21:Core/Src/calibration.c ****     uint8_t magic;
  22:Core/Src/calibration.c ****     float   angle_target;
  23:Core/Src/calibration.c **** } FlashData_t;
  24:Core/Src/calibration.c **** #pragma pack()
  25:Core/Src/calibration.c **** 
  26:Core/Src/calibration.c **** bool flash_load(float *scale, int32_t *offset, float *target, float *angle_target)
  27:Core/Src/calibration.c **** {
  28:Core/Src/calibration.c ****     const FlashData_t *p = (const FlashData_t *)FLASH_EEPROM_ADDR;
  29:Core/Src/calibration.c ****     if (p->magic != 0xAB && p->magic != 0xAC && p->magic != 0xAD) return false;
  30:Core/Src/calibration.c ****     if (scale)  *scale  = p->scale;
  31:Core/Src/calibration.c ****     if (offset) *offset = p->offset;
  32:Core/Src/calibration.c ****     if (target) *target = p->target_force;
  33:Core/Src/calibration.c ****     if (angle_target) {
  34:Core/Src/calibration.c ****         *angle_target = (p->magic == 0xAD) ? p->angle_target : ANGLE_DEFAULT_DEG;
  35:Core/Src/calibration.c ****     }
  36:Core/Src/calibration.c ****     return true;
  37:Core/Src/calibration.c **** }
  38:Core/Src/calibration.c **** 
  39:Core/Src/calibration.c **** bool flash_save(float scale, int32_t offset, float target, float angle_target)
  40:Core/Src/calibration.c **** {
  41:Core/Src/calibration.c ****     HAL_FLASH_Unlock();
  42:Core/Src/calibration.c **** 
  43:Core/Src/calibration.c ****     FLASH_EraseInitTypeDef erase = {
  44:Core/Src/calibration.c ****         .TypeErase    = FLASH_TYPEERASE_SECTORS,
  45:Core/Src/calibration.c ****         .Sector       = FLASH_EEPROM_SECTOR,
  46:Core/Src/calibration.c ****         .NbSectors    = 1,
  47:Core/Src/calibration.c ****         .VoltageRange = FLASH_VOLTAGE_RANGE_3
  48:Core/Src/calibration.c ****     };
  49:Core/Src/calibration.c ****     uint32_t sector_error = 0;
  50:Core/Src/calibration.c ****     if (HAL_FLASHEx_Erase(&erase, &sector_error) != HAL_OK) {
  51:Core/Src/calibration.c ****         HAL_FLASH_Lock();
  52:Core/Src/calibration.c ****         return false;
  53:Core/Src/calibration.c ****     }
  54:Core/Src/calibration.c **** 
  55:Core/Src/calibration.c ****     FlashData_t data = {
  56:Core/Src/calibration.c ****         .scale        = scale,
  57:Core/Src/calibration.c ****         .offset       = offset,
  58:Core/Src/calibration.c ****         .target_force = target,
  59:Core/Src/calibration.c ****         .magic        = EEPROM_MAGIC_VALUE,
  60:Core/Src/calibration.c ****         .angle_target = angle_target
  61:Core/Src/calibration.c ****     };
  62:Core/Src/calibration.c **** 
  63:Core/Src/calibration.c ****     // Записуємо побайтово (HAL_FLASH_Program підтримує BYTE)
  64:Core/Src/calibration.c ****     const uint8_t *src  = (const uint8_t *)&data;
  65:Core/Src/calibration.c ****     uint32_t       addr = FLASH_EEPROM_ADDR;
