 136:Core/Src/display.c **** static void build_screen_main(void)
 137:Core/Src/display.c **** {
 138:Core/Src/display.c ****     char tmp[LCD_COLS + 1];
 139:Core/Src/display.c ****     const char *mode = "IDLE";
 140:Core/Src/display.c **** 
 141:Core/Src/display.c ****     // Рядок 0: активний пресет або назва пристрою
 142:Core/Src/display.c ****     if (s_active_preset >= 0 && s_active_preset < PRESET_COUNT) {
 143:Core/Src/display.c ****         const Preset_t *p = &g_presets[s_active_preset];
 144:Core/Src/display.c ****         char rng[8];
 145:Core/Src/display.c ****         format_range_kN(rng, p->force_min_kN, p->force_max_kN);
 146:Core/Src/display.c ****         // "300 Nozzle  8.5-9.0"  = 3+1+8+7 = 19 chars → padded to 20
 147:Core/Src/display.c ****         snprintf(tmp, sizeof(tmp), "%-3s %-8s%s", p->inj_name, p->op_name, rng);
 148:Core/Src/display.c ****     } else {
 149:Core/Src/display.c ****         snprintf(tmp, sizeof(tmp), "VW NF PRESS");
 150:Core/Src/display.c ****     }
 151:Core/Src/display.c ****     make_line_padded(s_new_buf[0], tmp);
ARM GAS  /tmp/ccUzjlCM.s 			page 15


 152:Core/Src/display.c **** 
 153:Core/Src/display.c ****     // Рядок 1: поточне і задане зусилля
 154:Core/Src/display.c ****     snprintf(tmp, sizeof(tmp), "F:%5.2f kN  T:%5.2f",
 155:Core/Src/display.c ****              (double)s_force, (double)s_target);
 156:Core/Src/display.c ****     make_line_padded(s_new_buf[1], tmp);
 157:Core/Src/display.c **** 
 158:Core/Src/display.c ****     // Рядок 2: поточний / заданий кут
 159:Core/Src/display.c ****     s_blink_tick++;
 160:Core/Src/display.c ****     if (s_angle_reached && (s_blink_tick & 0x03U)) {
 161:Core/Src/display.c ****         make_line_padded(s_new_buf[2], "Angle: [  DONE!  ]  ");
 162:Core/Src/display.c ****     } else {
 163:Core/Src/display.c ****         snprintf(tmp, sizeof(tmp), "Angle:%6.1f /%6.1f",
 164:Core/Src/display.c ****                  (double)s_angle_current, (double)s_angle_target);
 165:Core/Src/display.c ****         make_line_padded(s_new_buf[2], tmp);
 166:Core/Src/display.c ****     }
 167:Core/Src/display.c **** 
 168:Core/Src/display.c ****     switch (s_motion_mode) {
 169:Core/Src/display.c ****         case DISPLAY_MODE_APPROACH: mode = "APPR"; break;
 170:Core/Src/display.c ****         case DISPLAY_MODE_SOFT:     mode = "SOFT"; break;
 171:Core/Src/display.c ****         case DISPLAY_MODE_PRESS:    mode = "PRESS"; break;
 172:Core/Src/display.c ****         case DISPLAY_MODE_ASEEK:    mode = "ASEEK"; break;
 173:Core/Src/display.c ****         case DISPLAY_MODE_HOLD:     mode = "HOLD"; break;
 174:Core/Src/display.c ****         case DISPLAY_MODE_DONE:     mode = "DONE"; break;
 175:Core/Src/display.c ****         case DISPLAY_MODE_FINE:     mode = "FINE"; break;
 176:Core/Src/display.c ****         case DISPLAY_MODE_RETRACT:  mode = "BACK"; break;
 177:Core/Src/display.c ****         case DISPLAY_MODE_IDLE:
 178:Core/Src/display.c ****         default:                    mode = "IDLE"; break;
 179:Core/Src/display.c ****     }
 180:Core/Src/display.c **** 
 181:Core/Src/display.c ****     snprintf(tmp, sizeof(tmp), "%-5s%4u  STOP", mode, (unsigned)s_motion_speed);
 182:Core/Src/display.c ****     make_line_padded(s_new_buf[3], tmp);
 183:Core/Src/display.c **** }
