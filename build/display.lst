   9:Core/Src/display.c **** // ===== LCD2004 через PCF8574 I2C =====
  10:Core/Src/display.c **** // PCF8574 бітове відображення:
  11:Core/Src/display.c **** //   P0 = RS,  P1 = RW,  P2 = EN,  P3 = Backlight
  12:Core/Src/display.c **** //   P4-P7 = D4-D7
  13:Core/Src/display.c **** 
  14:Core/Src/display.c **** #define LCD_RS        0x01
  15:Core/Src/display.c **** #define LCD_RW        0x02
  16:Core/Src/display.c **** #define LCD_EN        0x04
  17:Core/Src/display.c **** #define LCD_BACKLIGHT 0x08
  18:Core/Src/display.c **** 
  19:Core/Src/display.c **** #define LCD_COLS  20
  20:Core/Src/display.c **** #define LCD_ROWS  4
  21:Core/Src/display.c **** 
  22:Core/Src/display.c **** // DDRAM адреси рядків для LCD2004
  23:Core/Src/display.c **** static const uint8_t ROW_ADDR[4] = { 0x00, 0x40, 0x14, 0x54 };
  24:Core/Src/display.c **** 
