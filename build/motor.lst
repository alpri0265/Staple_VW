 329:Core/Src/motor.c **** // Викликати з main loop: перевіряє переходи стану
 330:Core/Src/motor.c **** void motor_update(void)
 331:Core/Src/motor.c **** {
 332:Core/Src/motor.c ****     // Якщо в стані ERROR — нічого не робимо, чекаємо команд
