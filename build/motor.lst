  98:Core/Src/motor.c **** static void motor_command(MotorState next_state, bool up, uint16_t speed, const MotorRampProfile *p
  99:Core/Src/motor.c **** {
 100:Core/Src/motor.c ****     if (s_state == MOTOR_ERROR) return;
 101:Core/Src/motor.c ****     if (up ? motor_is_limit_top() : motor_is_limit_bot()) return;
 102:Core/Src/motor.c **** 
 103:Core/Src/motor.c ****     uint16_t target = speed_to_period(speed);
 104:Core/Src/motor.c ****     if (target == 0) return;
 105:Core/Src/motor.c **** 
 106:Core/Src/motor.c ****     set_direction(up);
 107:Core/Src/motor.c **** 
 108:Core/Src/motor.c ****     __disable_irq();
 109:Core/Src/motor.c ****     if (s_state == next_state) {
 110:Core/Src/motor.c ****         s_period_target = target;
 111:Core/Src/motor.c ****         s_burst_steps   = 0;
 112:Core/Src/motor.c **** 
 113:Core/Src/motor.c ****         // Якщо оператор зменшив швидкість, не скидаємо ramp,
 114:Core/Src/motor.c ****         if (s_period_current == 0) {
 115:Core/Src/motor.c ****             s_period_current = motor_start_period(target, profile);
 116:Core/Src/motor.c ****             s_step_period    = s_period_current;
 117:Core/Src/motor.c ****             s_step_timer     = s_step_period;
 118:Core/Src/motor.c ****         }
 119:Core/Src/motor.c ****         if (s_accel_timer == 0) {
 120:Core/Src/motor.c ****             s_accel_timer = motor_next_accel_timer(profile);
 121:Core/Src/motor.c ****         }
 122:Core/Src/motor.c ****     } else {
 123:Core/Src/motor.c ****         s_period_target  = target;
 124:Core/Src/motor.c ****         s_period_current = motor_start_period(target, profile);
 125:Core/Src/motor.c ****         s_step_period    = s_period_current;
 126:Core/Src/motor.c ****         s_step_timer     = s_step_period;
 127:Core/Src/motor.c ****         s_accel_timer    = motor_next_accel_timer(profile);
 128:Core/Src/motor.c ****         s_burst_steps    = 0;
 129:Core/Src/motor.c ****         s_state          = next_state;
 130:Core/Src/motor.c ****         STEP_GPIO_Port->BSRR = (uint32_t)STEP_Pin << 16U;
 131:Core/Src/motor.c ****         s_step_state     = false;
 132:Core/Src/motor.c ****     }
 133:Core/Src/motor.c ****     __enable_irq();
 134:Core/Src/motor.c **** }
