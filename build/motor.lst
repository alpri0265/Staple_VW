 271:Core/Src/motor.c **** // Викликати з control timer IRQ (кожен CONTROL_TIM_TICK_US)
 272:Core/Src/motor.c **** void motor_tim_tick(void)
 273:Core/Src/motor.c **** {
 274:Core/Src/motor.c ****     if (s_pulse_timer > 0) {
 275:Core/Src/motor.c ****         s_pulse_timer--;
 276:Core/Src/motor.c ****         if (s_pulse_timer == 0U) {
 277:Core/Src/motor.c ****             STEP_GPIO_Port->BSRR = (uint32_t)STEP_Pin << 16U;  // STEP = LOW
 278:Core/Src/motor.c ****             s_step_state = false;
 279:Core/Src/motor.c ****         }
 280:Core/Src/motor.c ****     }
 281:Core/Src/motor.c **** 
 282:Core/Src/motor.c ****     if (s_step_period == 0) return;
 283:Core/Src/motor.c **** 
 284:Core/Src/motor.c ****     // Перевірка концевиків у ISR — зупиняє з IDLE (рух у про�
 285:Core/Src/motor.c ****     if (s_state == MOTOR_MOVING_UP && motor_is_limit_top()) {
 286:Core/Src/motor.c ****         motor_limit_stop_isr();
 287:Core/Src/motor.c ****         return;
 288:Core/Src/motor.c ****     }
 289:Core/Src/motor.c ****     if (s_state == MOTOR_MOVING_DOWN && motor_is_limit_bot()) {
 290:Core/Src/motor.c ****         motor_limit_stop_isr();
 291:Core/Src/motor.c ****         return;
 292:Core/Src/motor.c ****     }
 293:Core/Src/motor.c **** 
 294:Core/Src/motor.c ****     // Плавно підтягуємо current period до target без перезапуску �
 295:Core/Src/motor.c ****     if (s_accel_timer > 0) {
 296:Core/Src/motor.c ****         s_accel_timer--;
 297:Core/Src/motor.c ****     } else {
 298:Core/Src/motor.c ****         s_accel_timer = motor_next_accel_timer(&s_heavy_profile);
 299:Core/Src/motor.c ****         motor_apply_profile_step(&s_heavy_profile);
 300:Core/Src/motor.c ****     }
 301:Core/Src/motor.c **** 
 302:Core/Src/motor.c ****     // Генерація STEP: передній фронт = один крок, HIGH тримає�
 303:Core/Src/motor.c ****     if (s_step_timer > 0) {
 304:Core/Src/motor.c ****         s_step_timer--;
 305:Core/Src/motor.c ****     } else {
 306:Core/Src/motor.c ****         s_step_timer = s_step_period;
 307:Core/Src/motor.c ****         if (!s_step_state) {
 308:Core/Src/motor.c ****             STEP_GPIO_Port->BSRR = STEP_Pin;  // STEP = HIGH
 309:Core/Src/motor.c ****             s_step_state = true;
 310:Core/Src/motor.c ****             s_pulse_timer = STEP_PULSE_TICKS;
 311:Core/Src/motor.c **** 
 312:Core/Src/motor.c ****             if (s_state == MOTOR_MOVING_UP) {
 313:Core/Src/motor.c ****                 s_step_pos++;
 314:Core/Src/motor.c ****             } else if (s_state == MOTOR_MOVING_DOWN) {
 315:Core/Src/motor.c ****                 s_step_pos--;
 316:Core/Src/motor.c ****             }
 317:Core/Src/motor.c **** 
 318:Core/Src/motor.c ****             if (s_burst_steps > 0) {
 319:Core/Src/motor.c ****                 s_burst_steps--;
ARM GAS  /tmp/ccND7VLF.s 			page 36


 320:Core/Src/motor.c ****                 if (s_burst_steps == 0U) {
 321:Core/Src/motor.c ****                     s_step_period = 0;
 322:Core/Src/motor.c ****                     s_state = MOTOR_IDLE;
 323:Core/Src/motor.c ****                 }
 324:Core/Src/motor.c ****             }
 325:Core/Src/motor.c ****         }
 326:Core/Src/motor.c ****     }
 327:Core/Src/motor.c **** }
